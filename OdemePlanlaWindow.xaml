<Window x:Class="BenimFinansim.OdemePlanlaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Ödeme Planla" Height="500" Width="400" WindowStartupLocation="CenterOwner"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">
    
    <Border Background="White" CornerRadius="15" Margin="15" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1" Direction="270" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> 
                <RowDefinition Height="*"/>  
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="15,15,0,0" MouseLeftButtonDown="Window_MouseDown">
                <Grid>
                    <TextBlock Text="Yeni Ödeme Planı" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="16" FontWeight="Bold"
                            Click="BtnClose_Click" Cursor="Hand"/>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" Fill="#E2E8F0" VerticalAlignment="Bottom"/>

            <StackPanel Grid.Row="1" Margin="25,20,25,25">
                
                <TextBlock Text="Açıklama (Örn: Ev Kirası)" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <TextBox x:Name="txtBaslik" Margin="0,0,0,20" Height="42" FontSize="15" Foreground="#1E293B" VerticalContentAlignment="Center" Padding="15,0" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Aylık Tutar (TL)" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <TextBox x:Name="txtMiktar" Margin="0,0,0,20" Height="42" FontSize="16" FontWeight="Medium" Foreground="#1E293B" VerticalContentAlignment="Center" Padding="15,0" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Ödeme Günü (Ayın Kaçında?)" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <TextBox x:Name="txtGun" Margin="0,0,0,30" Height="42" FontSize="16" FontWeight="Medium" Foreground="#1E293B" VerticalContentAlignment="Center" Padding="15,0" BorderBrush="#CBD5E1" ToolTip="Örn: 15"/>

                <Button Content="Planı Kaydet" Click="Kaydet_Click" Background="#3B82F6" Foreground="White" 
                        FontWeight="Bold" FontSize="16" Height="50" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>